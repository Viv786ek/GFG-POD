 int ways(int x, int y) {
        // code here
        
        int n=x+1,m=y+1;
        const int mod=1e9+7;
        
        vector<vector<int>>dp(n,vector<int>(m,0));
        
        dp[0][0]=1;
        
        for(int i=1;i<n;i++)
        {
             dp[i][0]+=dp[i-1][0];
        }
        for(int j=1;j<m;j++)dp[0][j]+=dp[0][j-1];
        
        for(int i=1;i<n;i++)
        {
             for(int j=1;j<m;j++)
             {
            
                  
                  dp[i][j]=(dp[i-1][j]+dp[i][j-1])%mod;
             }
        }
        
        return dp[x][y]%mod;
    }
